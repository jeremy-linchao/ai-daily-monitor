{
  "name": "ai-daily-monitor",
  "version": "0.1.0",
  "description": "Daily AI/software/IT news aggregator with LLM-powered summarization and scoring",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "ai",
    "daily",
    "monitor",
    "llm",
    "aggregator"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^25.2.3",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "dotenv": "^17.3.1",
    "openai": "^6.22.0",
    "rss-parser": "^3.13.0",
    "undici": "^7.22.0"
  }
}
