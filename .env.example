# DeepSeek API key for LLM features (summarization, scoring, dedup)
# Get it from https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-xxxxx

# Feishu webhook URL for daily report push
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxx

# Optional: HTTP proxy for accessing foreign sites (arXiv, HuggingFace, GitHub, HN)
# Leave empty if not needed
HTTP_PROXY=http://127.0.0.1:1087

# Optional: log level (debug, info, warn, error)
LOG_LEVEL=info
