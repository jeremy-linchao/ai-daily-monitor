# LLM provider: "deepseek" or "anthropic" (default: deepseek)
LLM_PROVIDER=deepseek

# DeepSeek API key (required if LLM_PROVIDER=deepseek)
# Get it from https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-xxxxx

# Anthropic API key or OAuth setup token (required if LLM_PROVIDER=anthropic)
# API key (sk-ant-api03-...): https://console.anthropic.com/settings/keys
# Setup token (sk-ant-oat01-...): from Pro/Max subscription, auto-detected
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Optional: Feishu bot webhook for daily push
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxx

# Optional: HTTP proxy (according to your need)
HTTP_PROXY=your-proxy

# Optional: log level (debug, info, warn, error)
LOG_LEVEL=info
